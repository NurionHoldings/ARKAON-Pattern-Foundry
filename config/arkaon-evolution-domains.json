        "ux-color:semantic-accent-role",
        "ux-motion:text-enter-stagger",
        "ux-motion:reduce-motion-respect"
      ],
      "observation_signals": [
        "heading_depth_count",
        "font_role_count",
        "motion_prefers_reduced_media_query"
      ],
