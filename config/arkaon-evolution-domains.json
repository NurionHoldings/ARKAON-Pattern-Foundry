{
  "schema_version": "apf.evolution-domains/v1",
  "phase": "EXTERNAL_LEARNING_ONLY",
  "automatic_implement_allowed": false,
  "production_change_allowed": false,
  "external_budget_share": 0.65,
  "notes": [
    "abstract capability tokens only — no competitor verbatim, font files, or template asset copies",
    "CapCut and third-party editors: observe effect categories and timing principles, not proprietary presets",
    "phase 1 accumulates lessons; phase 2 proposes when operator requests a domain"
  ],
