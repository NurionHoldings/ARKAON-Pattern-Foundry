{
  "schema_version": "apf.continuous-collection/0.1",
  "enabled": true,
  "startup_trigger": "OS_BOOT",
  "collect_immediately": true,
  "interval_seconds": 900,
  "external_target_ratio": 0.65,
  "internal_target_ratio": 0.35,
  "minimum_intent_relevance": 0.30,
  "max_response_bytes": 5000000,
  "deny": [
    "personal_data",
    "credentials",
    "secrets",
    "unauthorized_private_sources",
    "robots_or_terms_violation"
  ],
  "deduplicate_by_content_hash": true,
  "unclear_license_mode": "FUNCTION_FIRST_WITH_INDEPENDENT_ASSET_EXCEPTION",
  "assetization_exception_bases": [
    "OWNED",
    "EXPLICIT_PERMISSION",
    "PUBLIC_DOMAIN",
    "CLEAN_ROOM_ABSTRACTION"
  ],
  "assetization_exception_requires": [
    "provenance_recorded",
    "no_source_code_copy"
  ],
  "assetization_route": [
    "REFERENCE_COLLECTED",
    "PRINCIPLE_ABSTRACTED",
    "INDEPENDENT_IMPLEMENTATION",
    "INDEPENDENTLY_VERIFIED",
    "OWNED_ASSET"
  ],
  "audit_every_decision": true
}
