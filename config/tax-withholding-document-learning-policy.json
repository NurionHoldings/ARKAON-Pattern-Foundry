{
  "schema_version": "apf.tax-withholding-document-learning/v1",
  "pattern_id": "tax-withholding-document-workflow",
  "status": "ETHERNIAN_REVIEW_REQUIRED",
  "mode": "PROPOSE_ONLY",
  "source_refresh_required_each_run": true,
  "authority": {
    "allowed": [
      "CALCULATE_FROM_USER_INPUT",
      "GENERATE_DOCUMENTS",
      "VERIFY_ARITHMETIC",
      "VERIFY_RENDERING",
      "SAVE_AFTER_EXPLICIT_USER_APPROVAL"
    ],
    "forbidden": [
      "LOOKUP_BUSINESS_OR_PERSONAL_DATA",
      "INFER_MISSING_IDENTITY_DATA",
      "REUSE_PRIOR_PERSONAL_DATA_AS_INPUT",
      "LOGIN_OR_SIGN",
      "SUBMIT_OR_PAY",
      "SHARE_OR_TRANSMIT"
    ]
  },
  "input_contract": {
    "business_data_source": "DIRECT_USER_INPUT_ONLY",
    "personal_data_source": "DIRECT_USER_INPUT_ONLY",
    "missing_sensitive_fields": "ASK_USER_OR_LEAVE_UNSET",
    "cross_case_personal_data_reuse": false
  },
  "steps": [
    "CONFIRM_SCOPE",
    "COLLECT_DIRECT_USER_INPUT",
    "VALIDATE_INPUT_FORMAT_AND_COMPLETENESS",
    "VERIFY_CURRENT_OFFICIAL_FORM",
    "SEPARATE_ACCRUAL_AND_PAYMENT_MONTH",
    "CLASSIFY_TAXABLE_AND_NONTAXABLE_PAY",
    "CONFIRM_DEPENDENT_INPUTS",
    "CALCULATE_INCOME_TAX_FROM_CURRENT_TABLE",
    "CALCULATE_LOCAL_INCOME_TAX_SEPARATELY",
    "ASSESS_SOCIAL_INSURANCE_FROM_USER_INPUT",
    "GENERATE_MONTHLY_FORMS",
    "SEPARATE_ACTUAL_AND_PLANNED_PAYMENTS",
    "GENERATE_RECONCILIATION_SUMMARY",
    "VERIFY_ARITHMETIC_RENDERING_AND_PRIVACY",
    "HUMAN_REVIEW_REQUIRED",
    "EXPLICIT_STORAGE_APPROVAL_REQUIRED",
    "SAVE_TO_USER_SELECTED_DESTINATION"
  ],
  "required_evidence_classes": [
    "CURRENT_NTS_FORM",
    "CURRENT_NTS_WITHHOLDING_TABLE",
    "CURRENT_SOCIAL_INSURANCE_RULES",
    "REPRODUCIBLE_CALCULATION",
    "RENDER_VERIFICATION",
    "USER_STORAGE_APPROVAL"
  ],
  "privacy": {
    "store_raw_resident_registration_number_in_learning_memory": false,
    "store_credentials_or_certificates": false,
    "store_taxpayer_specific_documents_as_learning_memory": false,
    "allow_abstracted_rules_and_redacted_test_vectors": true
  },
  "storage": {
    "default": "NO_SAVE",
    "explicit_user_approval_required": true,
    "user_selected_destination_required": true,
    "show_filename_format_and_sensitive_content_before_save": true,
    "saved_artifact_becomes_learning_memory": false,
    "sharing_or_transmission_included": false
  },
  "guards": {
    "automatic_submission": false,
    "automatic_payment": false,
    "automatic_transmission": false,
    "automatic_tax_amount_finalization_without_current_sources": false,
    "combine_monthly_filings_into_single_submission": false,
    "treat_planned_payment_as_filed": false,
    "human_review_required": true
  }
}
