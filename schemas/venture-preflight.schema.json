{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://arkaon.nurion.example/schemas/venture-preflight.schema.json","title":"ARKAON Venture Preflight","type":"object","required":["schema_version","project_id","status","evidence_digest","work_packets","unresolved_gates","next_action","planning_allowed","prototype_allowed","commercial_use_allowed","deployment_allowed"],"properties":{"schema_version":{"const":"apf.venture-preflight/1.0"},"project_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{2,63}$"},"status":{"enum":["RESEARCH_AND_PLANNING_ONLY","READY_FOR_CONTROLLED_PROTOTYPE","RIGHTS_CLEARED_SANDBOX_ONLY"]},"evidence_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"work_packets":{"type":"array","minItems":6},"unresolved_gates":{"type":"array","items":{"type":"string"}},"next_action":{"type":"string"},"planning_allowed":{"const":true},"prototype_allowed":{"type":"boolean"},"commercial_use_allowed":{"type":"boolean"},"deployment_allowed":{"const":false}},"additionalProperties":false}
