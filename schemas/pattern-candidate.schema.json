{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nurion.example/schemas/pattern-candidate/1.0",
  "title": "ARKAON Public Pattern Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pattern_id", "version", "title", "intent", "problem", "context", "forces", "solution", "invariants", "failure_modes", "security", "privacy", "license_provenance", "evidence_hashes", "source_refs", "test_refs", "verification_test_ids", "reuse_constraints", "applies_when", "not_when", "evidence_anchors", "status", "owned_asset", "semantic_fingerprint", "package_hash"],
  "properties": {
    "schema_version": {"const": "apf.pattern-candidate/1.0"},
    "pattern_id": {"type": "string", "pattern": "^apf\\.public\\.[a-z0-9-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"type": "string", "minLength": 3},
    "intent": {"type": "string", "minLength": 12},
    "problem": {"type": "string", "minLength": 12},
    "context": {"type": "string", "minLength": 12},
    "forces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "solution": {"type": "string", "minLength": 12},
    "invariants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "security": {"type": "string", "minLength": 12},
    "privacy": {"type": "string", "minLength": 12},
    "license_provenance": {"type": "object"},
    "evidence_hashes": {"type": "object", "minProperties": 2},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "test_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verification_test_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reuse_constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "applies_when": {"type": "string", "minLength": 12},
    "not_when": {"type": "string", "minLength": 12},
    "evidence_anchors": {"type": "object", "additionalProperties": false, "required": ["source_symbol", "test_name"], "properties": {"source_symbol": {"type": "string"}, "test_name": {"type": "string"}}},
    "status": {"const": "ETHERNIAN_REVIEW_REQUIRED"},
    "owned_asset": {"const": false},
    "semantic_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "package_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
