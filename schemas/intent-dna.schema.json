{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nurion.example/schemas/intent-dna/0.1",
  "title": "Intent_DNA",
  "type": "object",
  "additionalProperties": false,
  "required": ["analysis_run_id", "axes", "completeness"],
  "properties": {
    "analysis_run_id": {"type": "string", "format": "uuid"},
    "axes": {
      "type": "object",
      "propertyNames": {"enum": ["why", "who", "value", "outcome", "journey", "object", "owner", "invariant", "constraint", "risk", "signal", "evolution"]},
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonical_text", "evidence_refs", "confidence", "stability", "disputed"],
          "properties": {
            "canonical_text": {"type": "string", "minLength": 1},
            "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uuid"}},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "stability": {"enum": ["CORE", "CONFIGURABLE", "EXPERIMENTAL"]},
            "disputed": {"type": "boolean"}
          }
        }
      }
    },
    "completeness": {"type": "number", "minimum": 0, "maximum": 1},
    "fingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "locked": {"type": "boolean", "default": false}
  }
}

