{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nurion.example/schemas/pattern-package/0.1",
  "title": "Pattern Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "namespace", "slug", "version", "status", "pattern_type", "risk_class", "intent_dna_id", "source_evidence_ids", "approved_by", "approved_at", "content_hash"],
  "properties": {
    "schema_version": {"const": "apf.package/0.1"},
    "package_id": {"type": "string", "format": "uuid"},
    "namespace": {"type": "string", "pattern": "^[a-z0-9]+(?:\\.[a-z0-9-]+)+$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["OFFICIAL", "DEPRECATED", "REVOKED", "SUPERSEDED"]},
    "pattern_type": {"type": "string"},
    "risk_class": {"enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"]},
    "intent_dna_id": {"type": "string", "format": "uuid"},
    "source_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
    "approved_by": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "approved_at": {"type": "string", "format": "date-time"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

